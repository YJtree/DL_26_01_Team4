# --- .gitignore 파일 내용 ---

# 1. 가상환경 및 로컬 설정 파일
venv/
.env
.idea/
.vscode/

# 2. 파이썬 캐시 파일 (불필요한 파일)
__pycache__/
*.py[cod]
*$py.class

# 3. 딥러닝 모델 가중치 (용량 초과 방지)
*.pt
*.pth
*.h5
*.bin
*.ckpt

# 4. 크롤링 및 라벨링 원본 데이터 (로컬에서만 보관)
data/*.csv
data/*.xlsx
data/*.json
!data/sample_*.csv  # 단, sample_ 로 시작하는 샘플 데이터 파일은 팀원 공유를 위해 업로드 허용
